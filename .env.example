VITE_CHAT_WHATSAPP_NUMBER=491701234567
VITE_API_URL=

PORT=5000
CLIENT_URL=http://127.0.0.1:5174
ALLOWED_ORIGINS=https://www.viel-gs.de,https://viel-gs.de
CONTACT_TO_EMAIL=info@viel-gs.de
# Optional local-only override for temporary submission testing.
CONTACT_TEST_EMAIL=
MAIL_FROM_EMAIL=website@viel-gs.de
REQUIRE_EMAIL_DELIVERY=false
EMAIL_PROVIDER=auto

# Recommended for client sites: use Resend with a verified domain.
# The client only needs to approve DNS records and provide a sending API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VIEL Website <website@viel-gs.de>

# Optional fallback: SMTP credentials for a dedicated website mailbox.
# Without Resend or SMTP, submissions are accepted and logged in dry-run mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
